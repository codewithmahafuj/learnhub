# ---------------------------------------------------------------------------
# Neon PostgreSQL connection strings — NEVER commit real values.
# Get both from Neon Console -> "Connect":
#
#   DATABASE_URL : POOLED connection (hostname contains "-pooler")
#                  Used by the application (Prisma Client + Neon adapter).
#   DIRECT_URL   : DIRECT / unpooled connection (no "-pooler")
#                  Used by the Prisma CLI for migrations (prisma.config.ts).
#
# Both must keep sslmode=require for Neon.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Secret used to sign/encrypt the session JWT cookie. Generate one with:
#   openssl rand -base64 32
# or: npx auth secret
AUTH_SECRET=""

# Base path of the app (required in production behind proxies):
# AUTH_URL="http://localhost:3000"
